// Worker code, static assets and bindings. Nothing here is specific to one deployer:
// the account comes from CLOUDFLARE_ACCOUNT_ID and the hostname is attached by infra/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodtags-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths are client-side routes, so they get the app shell.
    "not_found_handling": "single-page-application",
    // Everything except the media bridge is served straight from the asset store,
    // which is free and does not count as a Worker request.
    "run_worker_first": ["/media"]
  },
  // Per client, per Cloudflare location. A tag opens a score plus a few tracks, so
  // this is far above real use and only stops someone draining the daily free quota.
  "ratelimits": [
    { "name": "MEDIA_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } }
  ]
}
