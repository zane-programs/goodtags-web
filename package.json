{
  "name": "goodtags-web",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-web-assets.mjs && vite --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/prepare-web-assets.mjs && yarn typecheck && vite build",
    "deploy": "yarn build && wrangler deploy",
    "deploy:all": "yarn deploy && yarn infra:apply && yarn deploy:check",
    "deploy:check": "node scripts/infra.mjs check",
    "infra:plan": "node scripts/infra.mjs plan",
    "infra:apply": "node scripts/infra.mjs apply",
    "infra:destroy": "node scripts/infra.mjs destroy",
    "logs": "wrangler tail",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint web worker scripts/serve.mjs scripts/infra.mjs vite.config.ts",
    "db:refresh": "./scripts/refresh-bundled-db.sh",
    "test:e2e": "playwright test",
    "format": "prettier --write web worker scripts/serve.mjs scripts/infra.mjs e2e/web vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdi/js": "^7.4.47",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.9.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.12.0"
}
